{
  "$schema": "https://schema.tauri.app/config/2.0.0-beta",
  "productName": "Cloud DevBox",
  "version": "0.1.0",
  "identifier": "io.devbox.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "beforeDevCommand": "npm run dev --prefix ../web"
  },
  "app": {
    "windows": [
      {
        "title": "Cloud DevBox",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "fileDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.devbox.io wss://api.devbox.io; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "shortDescription": "Cloud DevBox Desktop Client",
    "longDescription": "A desktop client for managing cloud development environments. Create, manage, and connect to cloud development environments directly from your desktop.",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Cloud DevBox Team",
    "publisher": "Cloud DevBox Team",
    "licenseFile": "../../LICENSE",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "wix": {
        "language": ["en-US", "zh-CN"],
        "template": "wix/main.wxs",
        "fragmentPaths": ["wix/fragments/*.wxs"],
        "componentGroupRefs": ["ProductComponents"],
        "featureGroupRefs": ["ProductFeatures"],
        "fileAssociations": [
          {
            "ext": "devbox",
            "name": "DevBox Environment",
            "description": "Cloud DevBox Environment Configuration",
            "role": "Editor"
          }
        ],
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp",
        "enableElevatedPrivilege": false
      },
      "nsis": {
        "template": "nsis/installer.nsi",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "devbox.io",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "providerShortName": null,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "background": "dmg-background.png",
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "files": {},
        "section": "devel",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ],
        "release": "1",
        "epoch": 0
      }
    },
    "externalBin": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "open-url",
          "cmd": "open",
          "args": true
        }
      ]
    },
    "updater": {
      "pubkey": "YOUR_PUBLIC_KEY_HERE",
      "endpoints": [
        "https://releases.devbox.io/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
